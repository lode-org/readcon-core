        "data/db32",
    output:
        "src/figures/generated/readcon_db_macros.tex",
    shell:
        "python3 scripts/readcon_db_macros.py"

rule mpi_log:
    output:
        "logs/mpi.log",
    shell:
        "python3 bench/run_mpi_v2.py"

rule mpi_products:
    input:
        "logs/mpi.log",
    output:
        "src/figures/generated/mpi_macros.tex",
        "src/figures/generated/mpi_host_table.tex",
        "src/figures/generated/mpi_host.pdf",
    shell:
        "python3 scripts/mpi_from_log.py"

rule mpi_fallback:
    output:
        "logs/mpi-fallback.log",
    shell:
        "python3 scripts/mpi_fallback.py"

rule dlpack_log:
