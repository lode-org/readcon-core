# Like-for-like reader benchmark. Run from this directory:
#   snakemake -c1

rule all:
    input:
        "results/rows.csv",
        "results/summary.csv",
        "results/samples.csv",
        "work/asv.stamp",

rule like_for_like:
    output:
        "results/rows.csv",
        "results/summary.csv",
        "results/samples.csv",
    shell:
        "python3 run_bench.py"

rule asv_like:
    input:
        "results/rows.csv",
    output:
        "work/asv.stamp",
    shell:
        "python3 run_asv.py && touch work/asv.stamp"
