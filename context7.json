{
  "$schema": "https://context7.com/schema/context7.json",
  "projectTitle": "readcon-core",
  "description": "Reference implementation of the versioned .con/.convel formats with multi-language bindings.",
  "folders": [
    "docs/orgmode",
    "examples",
    "include",
    "fortran",
    "julia"
  ],
  "excludeFolders": [
    "docs/source",
    "changelog.d",
    "benches",
    "benchmarks",
    "bench",
    "third_party",
    "tests",
    "scripts",
    ".github",
    "fuzz",
    "paper",
    "packaging",
    "support",
    "resources"
  ],
  "excludeFiles": [
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ],
  "rules": [
    "Python package is readcon; Rust crate is readcon-core."
  ]
}
