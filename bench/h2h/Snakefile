# Publication rerun. One target rebuilds the tables and the scaling figure
# from the raw logs written by scale_r6.py.

rule publication:
    input:
        "bench/h2h/scaling/r8/rows.json",
        "bench/h2h/scaling/r8/hardware.json",
        "bench/h2h/scaling/r8/h2h.json",
        "bench/h2h/scaling/r8/langs.json",
        "bench/h2h/scaling/r8/scaling.pdf",


rule measure:
    output:
        "bench/h2h/scaling/r8/rows.json",
        "bench/h2h/scaling/r8/hardware.json",
        "bench/h2h/scaling/r8/h2h.json",
        "bench/h2h/scaling/r8/langs.json",
    shell:
        "python3 bench/h2h/scale_r6.py"


rule figure:
    input:
        "bench/h2h/scaling/r8/rows.json",
    output:
        "bench/h2h/scaling/r8/scaling.pdf",
    shell:
        "python3 bench/h2h/plot_r6.py"


rule mem_r1:
    output:
        "bench/h2h/scaling/mem-r1/rows.json",
        "bench/h2h/scaling/mem-r1/hardware.json",
    shell:
        "python3 bench/h2h/mem_r1.py"


# One rerun of the paper campaigns on this commit. Raw logs stay under
# bench/h2h/scaling/rel1.
rule release:
    output:
        "bench/h2h/scaling/rel1/rows.json",
        "bench/h2h/scaling/rel1/hardware.json",
        "bench/h2h/scaling/rel1/h2h.json",
        "bench/h2h/scaling/rel1/langs.json",
        "bench/h2h/scaling/rel1/compressed.json",
        "bench/h2h/scaling/rel1/table2-h2h.tsv",
        "bench/h2h/scaling/rel1/table3-bindings.tsv",
        "bench/h2h/scaling/rel1/s61-strong.tsv",
        "bench/h2h/scaling/rel1/s-memory.tsv",
        "bench/h2h/scaling/rel1/memory.json",
        "bench/h2h/scaling/rel1/fig7-threads.pdf",
        "bench/h2h/scaling/rel1/fig8-mpi.pdf",
        "bench/h2h/scaling/rel1/fidelity.log",
        "bench/h2h/scaling/rel1/db.log",
        "bench/h2h/scaling/rel1/DONE",
    shell:
        "python3 bench/h2h/release_campaign.py"


# The release rerun: extxyz head-to-head, bindings, compressed CON,
# strong and weak scaling, fidelity, and readcon-db.
rule campaign:
    input:
        "bench/h2h/scaling/rel1/DONE",


# Final paper campaign. One target rebuilds the bindings from this
# checkout and reruns every campaign. Default output is
# bench/h2h/scaling/rel1 with n=6. A smoke run does not touch that
# directory:
#   snakemake -s bench/h2h/Snakefile --cores 1 \
#     --config out=/tmp/readcon-final-smoke repeats=1 final_campaign
# Each rule: one warmup, serial samples, type-7 median and IQR, raw
# samples in the JSON, unlink+create on writes, STREAM / fdatasync /
# raw pwrite ceilings, and the HEAD sha stamped into every output.
# final_compressed also records 1/2/4/8 thread ladders for 8-member
# gzip and zstd, with a per-count codec ceiling (inflate for reads,
# deflate for writes) and strong-scaling efficiency.
# final_check fails if any file under the output directory was produced
# on a commit other than HEAD. On the default path that directory is
# bench/h2h/scaling/rel1.
FINAL_OUT = config.get("out", "bench/h2h/scaling/rel1")
FINAL_REPEATS = int(config.get("repeats", 6))


rule final_bindings:
    output:
        f"{FINAL_OUT}/bindings.json",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py bindings --out {params.out} --repeats {params.repeats}"


rule final_ceilings:
    input:
        f"{FINAL_OUT}/bindings.json",
    output:
        f"{FINAL_OUT}/hardware.json",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py ceilings --out {params.out} --repeats {params.repeats}"


rule final_strong_threads:
    input:
        f"{FINAL_OUT}/bindings.json",
        f"{FINAL_OUT}/hardware.json",
    output:
        f"{FINAL_OUT}/strong-threads.json",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py strong-threads --out {params.out} --repeats {params.repeats}"


rule final_strong_mpi:
    input:
        f"{FINAL_OUT}/bindings.json",
        f"{FINAL_OUT}/hardware.json",
    output:
        f"{FINAL_OUT}/strong-mpi.json",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py strong-mpi --out {params.out} --repeats {params.repeats}"


rule final_weak:
    input:
        f"{FINAL_OUT}/bindings.json",
        f"{FINAL_OUT}/hardware.json",
    output:
        f"{FINAL_OUT}/weak-threads.json",
        f"{FINAL_OUT}/weak-ranks-1.json",
        f"{FINAL_OUT}/weak-ranks-2.json",
        f"{FINAL_OUT}/weak-ranks-4.json",
        f"{FINAL_OUT}/weak-ranks-8.json",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py weak --out {params.out} --repeats {params.repeats}"


rule final_langs:
    input:
        f"{FINAL_OUT}/bindings.json",
        f"{FINAL_OUT}/hardware.json",
    output:
        f"{FINAL_OUT}/langs.json",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py langs --out {params.out} --repeats {params.repeats}"


# 8-member gzip and zstd, threads 1/2/4/8, plus the codec ceiling.
rule final_compressed:
    input:
        f"{FINAL_OUT}/bindings.json",
        f"{FINAL_OUT}/hardware.json",
    output:
        f"{FINAL_OUT}/compressed.json",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py compressed --out {params.out} --repeats {params.repeats}"


rule final_table2:
    input:
        f"{FINAL_OUT}/bindings.json",
        f"{FINAL_OUT}/hardware.json",
    output:
        f"{FINAL_OUT}/h2h.json",
        f"{FINAL_OUT}/h2h.log",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py table2 --out {params.out} --repeats {params.repeats}"


