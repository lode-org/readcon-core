    input:
        f"{FINAL_OUT}/bindings.json",
        f"{FINAL_OUT}/hardware.json",
    output:
        f"{FINAL_OUT}/fidelity.json",
        f"{FINAL_OUT}/fidelity-timing.json",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py fidelity --out {params.out} --repeats {params.repeats}"


rule final_check:
    input:
        f"{FINAL_OUT}/bindings.json",
        f"{FINAL_OUT}/hardware.json",
        f"{FINAL_OUT}/strong-threads.json",
        f"{FINAL_OUT}/strong-mpi.json",
        f"{FINAL_OUT}/weak-threads.json",
        f"{FINAL_OUT}/weak-ranks-1.json",
        f"{FINAL_OUT}/weak-ranks-2.json",
        f"{FINAL_OUT}/weak-ranks-4.json",
        f"{FINAL_OUT}/weak-ranks-8.json",
        f"{FINAL_OUT}/langs.json",
        f"{FINAL_OUT}/compressed.json",
        f"{FINAL_OUT}/h2h.json",
        f"{FINAL_OUT}/con-h2h.json",
        f"{FINAL_OUT}/db.log",
        f"{FINAL_OUT}/fidelity.json",
        f"{FINAL_OUT}/fidelity-timing.json",
    output:
        f"{FINAL_OUT}/COMMIT_OK",
    params:
        out=FINAL_OUT,
    shell:
        "python3 bench/h2h/final_campaign.py check --out {params.out}"


rule final_campaign:
    input:
        f"{FINAL_OUT}/COMMIT_OK",
