# Final paper campaign. One target rebuilds the bindings from this
# checkout and reruns every campaign. Default output is
# bench/h2h/scaling/rel1 with n=6. A smoke run does not touch that
# directory:
#   snakemake -s bench/h2h/Snakefile --cores 1 \
#     --config out=build/bench-smoke repeats=1 final_campaign
# Each rule: one warmup, serial samples, type-7 median and IQR, raw
# samples in the JSON, unlink+create on writes, STREAM / fdatasync /
# raw pwrite ceilings, and the HEAD sha stamped into every output.
# final_compressed also records 1/2/4/8 thread ladders for 8-member
# gzip and zstd, with a per-count codec ceiling (inflate for reads,
# deflate for writes) and strong-scaling efficiency.
# final_check fails if any file under the output directory was produced
# on a commit other than HEAD. On the default path that directory is
# bench/h2h/scaling/rel1.
import os
import subprocess
import sys
from pathlib import Path

_SNAKEFILE = os.path.abspath(workflow.snakefile)
_REPO = os.path.abspath(os.path.join(os.path.dirname(_SNAKEFILE), "..", ".."))
with open(os.path.join(_REPO, "VERSION"), encoding="utf-8") as _version_file:
    _RELEASE = _version_file.read().strip()


def _git_output(args, failure):
    try:
        return subprocess.check_output(args, text=True)
    except (OSError, subprocess.CalledProcessError):
        raise SystemExit(failure)


_TIP = _git_output(
    ["git", "-C", _REPO, "rev-parse", "HEAD"],
    "refusing to write a saved record: could not read the git tip",
).strip()
_TIP_SHORT = _git_output(
    ["git", "-C", _REPO, "rev-parse", "--short=12", "HEAD"],
    "refusing to write a saved record: could not read the git tip",
).strip()


def _canonical_repo_path(raw):
    # Follow symlinks and collapse "." and ".." before any comparison.
    # A path that leaves the repository is refused.
    resolved = Path(_REPO, str(raw)).resolve()
    try:
        relative = resolved.relative_to(Path(_REPO).resolve())
    except ValueError:
        raise SystemExit("refusing to write a saved record")
    return relative.as_posix()


def _cli_targets():
    skip_next = False
    found = []
    for arg in sys.argv[1:]:
        if skip_next:
            skip_next = False
            continue
        if arg in {
            "-s",
            "--snakefile",
            "--config",
            "--configfile",
            "-d",
            "--directory",
            "-c",
            "--cores",
            "-j",
            "--jobs",
            "--resources",
        }:
            skip_next = True
            continue
        if arg.startswith("-") or "=" in arg:
            continue
        found.append(arg)
    return found


