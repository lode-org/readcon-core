# Publication rerun. One target rebuilds the tables and the scaling figure
# from the raw logs written by scale_r6.py.

rule publication:
    input:
        "bench/h2h/scaling/r8/rows.json",
        "bench/h2h/scaling/r8/hardware.json",
        "bench/h2h/scaling/r8/h2h.json",
        "bench/h2h/scaling/r8/langs.json",
        "bench/h2h/scaling/r8/scaling.pdf",


rule measure:
    output:
        "bench/h2h/scaling/r8/rows.json",
        "bench/h2h/scaling/r8/hardware.json",
        "bench/h2h/scaling/r8/h2h.json",
        "bench/h2h/scaling/r8/langs.json",
    shell:
        "python3 bench/h2h/scale_r6.py"


rule figure:
    input:
        "bench/h2h/scaling/r8/rows.json",
    output:
        "bench/h2h/scaling/r8/scaling.pdf",
    shell:
        "python3 bench/h2h/plot_r6.py"


rule mem_r1:
    output:
        "bench/h2h/scaling/mem-r1/rows.json",
        "bench/h2h/scaling/mem-r1/hardware.json",
    shell:
        "python3 bench/h2h/mem_r1.py"


# One rerun of the paper campaigns on this commit. Raw logs stay under
# bench/h2h/scaling/rel1.
rule release:
    output:
        "bench/h2h/scaling/rel1/rows.json",
        "bench/h2h/scaling/rel1/hardware.json",
        "bench/h2h/scaling/rel1/h2h.json",
        "bench/h2h/scaling/rel1/langs.json",
        "bench/h2h/scaling/rel1/compressed.json",
        "bench/h2h/scaling/rel1/table2-h2h.tsv",
        "bench/h2h/scaling/rel1/table3-bindings.tsv",
        "bench/h2h/scaling/rel1/s61-strong.tsv",
        "bench/h2h/scaling/rel1/s-memory.tsv",
        "bench/h2h/scaling/rel1/memory.json",
        "bench/h2h/scaling/rel1/fig7-threads.pdf",
        "bench/h2h/scaling/rel1/fig8-mpi.pdf",
        "bench/h2h/scaling/rel1/fidelity.log",
        "bench/h2h/scaling/rel1/db.log",
        "bench/h2h/scaling/rel1/DONE",
    shell:
        "python3 bench/h2h/release_campaign.py"


# The release rerun: extxyz head-to-head, bindings, compressed CON,
# strong and weak scaling, fidelity, and readcon-db.
rule campaign:
    input:
        "bench/h2h/scaling/rel1/DONE",
