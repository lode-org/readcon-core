rule rerun_supersede:
    input:
        f"{FINAL_OUT}/COMMIT_OK",
        f"{FINAL_OUT}/camp24/ranked.json",
        f"{FINAL_OUT}/gil-concurrent.json",
        f"{FINAL_OUT}/threadfix-before-after.json",
        f"{FINAL_OUT}/parse-limiter.json",
        f"{MILLION}/host.json",
        f"{RERUN_MILLION_RESULTS}/million_hold.json",
        f"{RERUN_MILLION_RESULTS}/peers_n1e6.json",
        f"{RERUN_FORMATS}/1k/cross-format.json",
        f"{RERUN_FORMATS}/100k/cross-format.json",
        f"{RERUN_FORMATS}/1m/cross-format.json",
        f"{RERUN_FORMATS}/1m-mmcif/cross-format.json",
        f"{RERUN_FORMATS}/traj/cross-format.json",
        f"{RERUN_FORMATS}/extra/cross-format.json",
        f"{RERUN_FORMATS}/asv/asv.json",
        f"{RERUN_FORMATS}/lscpu.txt",
        f"{RERUN_CPC}/logs/mpi.log",
        f"{RERUN_CPC}/logs/mpi-fallback.log",
        f"{RERUN_CPC}/logs/reader-exchange.log",
        f"{RERUN_CPC}/data/dlpack_cost.txt",
        f"{RERUN_CPC}/data/db/summary.csv",
        f"{RERUN_CPC}/data/novel/fidelity.json",
    output:
        f"{FINAL_OUT}/SUPERSEDED.OK",
    params:
        tip=_TIP,
        scaling=FINAL_OUT,
        formats=RERUN_FORMATS,
        million=MILLION,
        million_results=RERUN_MILLION_RESULTS,
        cpc=RERUN_CPC,
    threads: 999
    shell:
        """
        python3 bench/h2h/rerun_helpers.py supersede \
            --tip "{params.tip}" \
            --scaling-out "{params.scaling}" \
            --formats-out "{params.formats}" \
            --million-out "{params.million}" \
            --million-results-out "{params.million_results}" \
            --cpc-out "{params.cpc}"
        """


rule rerun_paper:
