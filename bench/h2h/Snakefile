# The release rerun: extxyz head-to-head, bindings, compressed CON,
# strong and weak scaling, fidelity, and readcon-db.
rule campaign:
    input:
        "bench/h2h/scaling/rel1/DONE",


# Final paper campaign. One target rebuilds the bindings from this
# checkout and reruns every campaign. Default output is
# bench/h2h/scaling/rel1 with n=6. A smoke run does not touch that
# directory:
#   snakemake -s bench/h2h/Snakefile --cores 1 \
#     --config out=build/bench-smoke repeats=1 final_campaign
# Each rule: one warmup, serial samples, type-7 median and IQR, raw
# samples in the JSON, unlink+create on writes, STREAM / fdatasync /
# raw pwrite ceilings, and the HEAD sha stamped into every output.
# final_compressed also records 1/2/4/8 thread ladders for 8-member
# gzip and zstd, with a per-count codec ceiling (inflate for reads,
# deflate for writes) and strong-scaling efficiency.
# final_check fails if any file under the output directory was produced
# on a commit other than HEAD. On the default path that directory is
# bench/h2h/scaling/rel1.
FINAL_OUT = config.get("out", "bench/h2h/scaling/rel1")
FINAL_REPEATS = int(config.get("repeats", 6))

# A stale PYTHONPATH must not shadow the wheel this campaign installs.
shell.prefix("unset PYTHONPATH; ")


rule final_bindings:
    output:
        f"{FINAL_OUT}/bindings.json",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py bindings --out {params.out} --repeats {params.repeats}"


rule final_ceilings:
    input:
        f"{FINAL_OUT}/bindings.json",
    output:
        f"{FINAL_OUT}/hardware.json",
        f"{FINAL_OUT}/lscpu.txt",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py ceilings --out {params.out} --repeats {params.repeats}"


rule final_strong_threads:
    input:
        f"{FINAL_OUT}/bindings.json",
        f"{FINAL_OUT}/hardware.json",
    output:
        f"{FINAL_OUT}/strong-threads.json",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py strong-threads --out {params.out} --repeats {params.repeats}"


rule final_strong_mpi:
    input:
        f"{FINAL_OUT}/bindings.json",
        f"{FINAL_OUT}/hardware.json",
    output:
        f"{FINAL_OUT}/strong-mpi.json",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py strong-mpi --out {params.out} --repeats {params.repeats}"


rule final_weak:
    input:
        f"{FINAL_OUT}/bindings.json",
        f"{FINAL_OUT}/hardware.json",
    output:
        f"{FINAL_OUT}/weak-threads.json",
        f"{FINAL_OUT}/weak-ranks-1.json",
        f"{FINAL_OUT}/weak-ranks-2.json",
        f"{FINAL_OUT}/weak-ranks-4.json",
        f"{FINAL_OUT}/weak-ranks-8.json",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py weak --out {params.out} --repeats {params.repeats}"


# Concurrent pwrite of N frame-sized payloads at disjoint offsets, plus
# one thread pwriting those same bytes. Samples stay inside one process.
# The asv class WeakWrite times one call of the same helpers.
rule sink_ceiling:
    input:
        f"{FINAL_OUT}/bindings.json",
    output:
        f"{FINAL_OUT}/sink-ceiling.json",
        f"{FINAL_OUT}/samples.log",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/weak_write.py sink --out {params.out} --repeats {params.repeats}"


# Weak writes beside that ceiling. The table has two efficiency columns:
# ideal T(1)/T(N), and max(format alone, sink(N)) / T(N).
rule weak_write:
    input:
        f"{FINAL_OUT}/sink-ceiling.json",
        f"{FINAL_OUT}/hardware.json",
    output:
        f"{FINAL_OUT}/weak-rows.json",
        f"{FINAL_OUT}/weak-write.json",
        f"{FINAL_OUT}/weak-write-table.tsv",
        f"{FINAL_OUT}/NOTES.txt",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/weak_write.py weak --out {params.out} --repeats {params.repeats}"


rule final_langs:
    input:
        f"{FINAL_OUT}/bindings.json",
        f"{FINAL_OUT}/hardware.json",
    output:
        f"{FINAL_OUT}/langs.json",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    shell:
        "python3 bench/h2h/final_campaign.py langs --out {params.out} --repeats {params.repeats}"


