# Same compressed .con/.extxyz files, readcon vs ASE vs eOn.
# Same structures in each library's own format. readcon is CON
# (plain, gz, zst). Chemfiles has no CON reader; the other arms are
# extxyz, XYZ, PDB, DCD, XTC, and NetCDF where that library imports.
rule cross_format:
    input:
        f"{FINAL_OUT}/bindings.json",
        f"{FINAL_OUT}/hardware.json",
    output:
        f"{FINAL_OUT}/cross-format.json",
        f"{FINAL_OUT}/cross-format.log",
        f"{FINAL_OUT}/cross-format.tsv",
