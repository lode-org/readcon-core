# Fresh-file ranked writes. The spare is a separate table, not the default.
# n=12, one warmup, pinned. Does not edit bench/h2h/scaling/camp16.
rule camp16b:
    output:
        "bench/h2h/scaling/camp16b/DONE",
    shell:
        "mkdir -p bench/h2h/scaling/camp16b/logs && python3 bench/h2h/camp16b_run.py"


# Million-atom matrix. An existing record directory is refused before
# Snakemake creates the output directory. A real run writes
# bench/h2h/million/v<release>-<12-character tip> and names that
# directory and the tip in the previous record's SUPERSEDED.md, and
# only after those new outputs exist.
# Fresh process per sample, pinned to the starting CPU set, one warmup,
# n=12, type-7 median and IQR. The asv class times the same readcon calls.
# ``--config ops=write`` times writes. The default times reads and writes.
# ``--config million_out=...`` selects a different directory and is refused
# when that directory is a committed record or lies under bench/h2h/scaling.
# The path is resolved first, so ".", "..", an absolute path, and a symlink
# are the same directory. The working directory has to be the repository.
MILLION_SAVED = f"bench/h2h/million/v{_RELEASE}"
_million_override = config.get("million_out")
if _million_override:
    MILLION = _canonical_repo_path(str(_million_override).rstrip("/"))
else:
    MILLION = _canonical_repo_path(f"bench/h2h/million/v{_RELEASE}-{_TIP_SHORT}")
MILLION_OPS = config.get("ops", "read,write")
MILLION_MEASURE = [
    f"{MILLION}/cross-format.json",
    f"{MILLION}/cross-format.log",
    f"{MILLION}/cross-format.tsv",
]
if "read" in MILLION_OPS.split(","):
    MILLION_MEASURE.append(f"{MILLION}/chemfiles-write-profile.txt")


def _measure_outputs_missing():
    return any(not os.path.isfile(path) for path in MILLION_MEASURE)


def _require_repo_cwd():
    if Path(os.getcwd()).resolve() != Path(_REPO).resolve():
        raise SystemExit("refusing to write a saved record")


def _committed_record_directories():
    # A committed measurement, not the benchmark package that sits beside it.
    # git ls-files is the list of record directories, so a later release is
    # included when its cross-format.json is committed. Resolve each one the
    # same way as the requested output.
    listed = _git_output(
        ["git", "-C", _REPO, "ls-files", "-z", "--", "bench/h2h/million"],
        "refusing to write a saved record: could not list committed records",
    )
    marker = "/cross-format.json"
    found = set()
    for raw in listed.split("\0"):
        if not raw.endswith(marker):
            continue
        found.add(_canonical_repo_path(raw[: -len(marker)]))
    return found


def _refuse_saved_path(path):
    normalized = _canonical_repo_path(path)
    scaling = _canonical_repo_path("bench/h2h/scaling")
    if normalized == scaling or normalized.startswith(scaling + "/"):
        raise SystemExit("refusing to write a saved record")
    for saved in _committed_record_directories():
        if normalized == saved or normalized.startswith(saved + "/"):
            raise SystemExit("refusing to write a saved record")


def _refuse_saved_record(path):
    # Snakemake creates output directories before the shell. This check has
    # to run first, and only for a million-atom target, so another rule's
    # dry run is left alone.
    _refuse_saved_path(path)
    normalized = _canonical_repo_path(path)
    if os.path.isdir(normalized):
        raise SystemExit("refusing to write a saved record")


_MILLION_RULES = {
    "million",
    "million_measure",
    "million_asv",
    "million_record",
}


def _refuse_million_target(targets):
    # A fresh measurement is refused when the directory already exists.
    # A later step is refused on a committed record even when the
    # measurement files are present, and also while one of them is missing.
    # million_asv and million_record are later steps: they write into the
    # same directory and use the same guard.
    # Snakemake normalizes a file target onto the rule output. Compare the
    # resolved path, and refuse one that lands in any committed record even
    # when the selected output directory is a new one.
    measure_files = {_canonical_repo_path(path) for path in MILLION_MEASURE}
    prefix = MILLION + "/"
    records = None
    later_step = False
    for target in targets:
        raw = str(target)
        if raw in _MILLION_RULES:
            text = raw
        else:
            text = _canonical_repo_path(raw)
            if records is None:
                records = _committed_record_directories()
            for saved in records:
                if text == saved or text.startswith(saved + "/"):
                    raise SystemExit("refusing to write a saved record")
        if text == "million_measure" or text in measure_files:
            _require_repo_cwd()
            _refuse_saved_record(MILLION)
            return
        if (
            text == "million"
            or text == "million_asv"
            or text == "million_record"
            or text == MILLION
            or text.startswith(prefix)
        ):
            later_step = True
    if later_step:
        _require_repo_cwd()
        _refuse_saved_path(MILLION)
        if _measure_outputs_missing():
            _refuse_saved_record(MILLION)


def _refuse_release_saved_path(path):
    normalized = _canonical_repo_path(path)
    saved_prefixes = (
        "bench/h2h/scaling",
        "bench/h2h/formats/v0.23.3",
        "bench/h2h/million/v0.23.3",
        "bench/h2h/results",
        "bench/h2h/logs",
        "bench/fidelity/results",
        "paper/cpc/bench/results/r0174",
        "paper/cpc/bench/results/v0.23.3",
        "paper/cpc/data",
        "paper/cpc/logs",
        "benches/results",
    )
    for prefix in saved_prefixes:
        canon = _canonical_repo_path(prefix)
        if normalized == canon or normalized.startswith(canon + "/"):
            raise SystemExit(f"refusing to write a saved record: {normalized}")
    for saved in _committed_record_directories():
        if normalized == saved or normalized.startswith(saved + "/"):
            raise SystemExit(f"refusing to write a saved record: {normalized}")


def _refuse_release_target(targets):
    matched = any(
        str(target) in _RERUN_RULES
        or str(target).startswith(
            (RERUN_FORMATS + "/", RERUN_CPC + "/", RERUN_MILLION_RESULTS + "/")
        )
        for target in targets
    )
    if not matched:
        return
    _require_repo_cwd()
    if FINAL_REPEATS < 6:
        raise SystemExit(
            f"refusing release rerun: repeats must be >= 6, got {FINAL_REPEATS}"
        )
    status = _git_output(
        ["git", "-C", _REPO, "status", "--porcelain", "--untracked-files=all"],
        "refusing release rerun: could not read git status",
    ).strip()
    if status:
        raise SystemExit("refusing release rerun on a dirty tree:\n" + status)
    branches = _git_output(
        ["git", "-C", _REPO, "branch", "-r", "--contains", "HEAD"],
        "refusing release rerun: git branch -r --contains HEAD failed",
    ).strip()
    if not branches:
        raise SystemExit(
            f"refusing release rerun: {_TIP} is not on any remote branch "
            "(git branch -r --contains HEAD is empty)"
        )
    for dest in (
        FINAL_OUT,
        RERUN_FORMATS,
        MILLION,
        RERUN_MILLION_RESULTS,
        RERUN_CPC,
    ):
        _refuse_release_saved_path(dest)


_refuse_million_target(_cli_targets())
_refuse_release_target(_cli_targets())


onstart:
    settings = workflow.dag_settings
    requested = list(settings.targets) if settings is not None and settings.targets else []
    _refuse_million_target(requested)
    _refuse_release_target(requested)


rule million_measure:
    threads: 999
    output:
        # A later change of the shell or the tip must not replace a record.
        protected(MILLION_MEASURE),
    params:
        out=MILLION,
        previous=MILLION_SAVED,
        tip=_TIP,
        ops=MILLION_OPS,
    shell:
        """
        set -euo pipefail
        out="{params.out}"
        previous="{params.previous}"
        tip="{params.tip}"
        ops="{params.ops}"
        export READCON_CROSS_STRUCTURES=1M
        export OMP_NUM_THREADS=1
        export OPENBLAS_NUM_THREADS=1
        export MKL_NUM_THREADS=1
        export NUMEXPR_NUM_THREADS=1
        export VECLIB_MAXIMUM_THREADS=1
        export RAYON_NUM_THREADS=1
        python3 bench/h2h/cross_format.py --out "{params.out}" --repeats 12 --ops "{params.ops}"
        rm -f "{params.out}/profile.dcd"
        test -s "$out/cross-format.json"
        test -s "$out/cross-format.log"
        test -s "$out/cross-format.tsv"
        case ",$ops," in
            *,read,*) test -s "$out/chemfiles-write-profile.txt" ;;
        esac
        if [ -d "$previous" ] && [ "$previous" != "$out" ]; then
            cat > "${{previous}}/SUPERSEDED.md" <<EOF
Superseded by ${{out}}.
Tip: ${{tip}}.
EOF
        fi
        """


rule million_asv:
    threads: 999
    input:
        f"{MILLION}/cross-format.json",
    output:
