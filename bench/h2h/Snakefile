rule rerun_gil_threadfix:
    input:
        f"{FINAL_OUT}/COMMIT_OK",
    output:
        f"{FINAL_OUT}/gil-concurrent.json",
        f"{FINAL_OUT}/gil-concurrent.log",
        f"{FINAL_OUT}/threadfix-before-after.json",
        f"{FINAL_OUT}/threadfix-before-after.log",
    params:
        out=FINAL_OUT,
        repeats=FINAL_REPEATS,
    threads: 999
    shell:
        """
        python3 bench/h2h/gil_threadfix_bench.py --out {params.out} --repeats {params.repeats}
        python3 bench/h2h/gil_threadfix_bench.py --require-record {params.out}/threadfix-before-after.json
        """


rule rerun_parse_limiter:
