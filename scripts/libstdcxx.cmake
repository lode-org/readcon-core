# chemfiles-sys runs cmake before readcon's build.rs. On a native Linux
# host, /usr/bin/c++ may be clang, and clang does not search the directory
# that holds GCC's libstdc++.so. project() then dies with
# "cannot find -lstdc++". Add that directory before the compiler test.
# Cross builds do not use the host library. cmake-rs skips its own
# CMAKE_SYSTEM_NAME when this file is set, so a cross build restores it.
# It also skips -DCMAKE_C/CXX_COMPILER, so a cross build copies CC/CXX.

if(DEFINED ENV{CMAKE_TOOLCHAIN_FILE})
  get_filename_component(_readcon_user "$ENV{CMAKE_TOOLCHAIN_FILE}" ABSOLUTE)
  get_filename_component(_readcon_self "${CMAKE_CURRENT_LIST_FILE}" ABSOLUTE)
  if(NOT _readcon_user STREQUAL _readcon_self)
    include("${_readcon_user}")
    return()
  endif()
endif()

if(DEFINED ENV{TARGET} AND DEFINED ENV{HOST} AND NOT "$ENV{TARGET}" STREQUAL "$ENV{HOST}")
  set(_readcon_cross ON)
else()
  set(_readcon_cross OFF)
endif()

if(_readcon_cross AND NOT CMAKE_SYSTEM_NAME)
  set(_os "$ENV{CARGO_CFG_TARGET_OS}")
  set(_arch "$ENV{CARGO_CFG_TARGET_ARCH}")
  set(_proc "${_arch}")
  if(_os STREQUAL "android")
    set(_name "Android")
    if(_arch STREQUAL "arm")
      set(_proc "armv7-a")
    elseif(_arch STREQUAL "x86")
      set(_proc "i686")
    endif()
  elseif(_os STREQUAL "dragonfly")
    set(_name "DragonFly")
  elseif(_os STREQUAL "macos")
    set(_name "Darwin")
    if(_arch STREQUAL "aarch64")
      set(_proc "arm64")
    endif()
  elseif(_os STREQUAL "freebsd")
    set(_name "FreeBSD")
    if(_arch STREQUAL "x86_64")
      set(_proc "amd64")
    endif()
  elseif(_os STREQUAL "fuchsia")
    set(_name "Fuchsia")
  elseif(_os STREQUAL "haiku")
    set(_name "Haiku")
  elseif(_os STREQUAL "ios")
    set(_name "iOS")
    if(_arch STREQUAL "aarch64")
      set(_proc "arm64")
    endif()
  elseif(_os STREQUAL "linux")
    set(_name "Linux")
    if(_arch STREQUAL "powerpc")
      set(_proc "ppc")
    elseif(_arch STREQUAL "powerpc64")
      set(_proc "ppc64")
    elseif(_arch STREQUAL "powerpc64le")
      set(_proc "ppc64le")
    endif()
  elseif(_os STREQUAL "netbsd")
    set(_name "NetBSD")
  elseif(_os STREQUAL "openbsd")
    set(_name "OpenBSD")
    if(_arch STREQUAL "x86_64")
      set(_proc "amd64")
    endif()
  elseif(_os STREQUAL "solaris")
    set(_name "SunOS")
  elseif(_os STREQUAL "tvos")
    set(_name "tvOS")
    if(_arch STREQUAL "aarch64")
      set(_proc "arm64")
    endif()
  elseif(_os STREQUAL "visionos")
    set(_name "visionOS")
    if(_arch STREQUAL "aarch64")
      set(_proc "arm64")
    endif()
  elseif(_os STREQUAL "watchos")
    set(_name "watchOS")
    if(_arch STREQUAL "aarch64")
      set(_proc "arm64")
    endif()
  elseif(_os STREQUAL "windows")
    set(_name "Windows")
    if(_arch STREQUAL "x86_64")
      set(_proc "AMD64")
    elseif(_arch STREQUAL "x86")
      set(_proc "X86")
    elseif(_arch STREQUAL "aarch64")
      set(_proc "ARM64")
    endif()
  elseif(_os STREQUAL "none")
    set(_name "Generic")
  elseif(NOT _os STREQUAL "")
    set(_name "${_os}")
  else()
    set(_name "")
  endif()
  if(NOT _name STREQUAL "")
    set(CMAKE_SYSTEM_NAME "${_name}")
    set(CMAKE_SYSTEM_PROCESSOR "${_proc}")
  endif()
endif()

if(_readcon_cross)
  # Same lookup order as cmake-rs / the cc crate: dashed triple, then
  # underscores, then TARGET_CC / TARGET_CXX, then the plain variable.
  string(REPLACE "-" "_" _target_u "$ENV{TARGET}")
  foreach(_base IN ITEMS CC CXX)
    set(_picked "")
    foreach(_name IN ITEMS "${_base}_$ENV{TARGET}" "${_base}_${_target_u}" "TARGET_${_base}" "${_base}")
      if(_picked STREQUAL "" AND DEFINED ENV{${_name}} AND NOT "$ENV{${_name}}" STREQUAL "")
        set(_picked "$ENV{${_name}}")
      endif()
    endforeach()
    if(NOT _picked STREQUAL "")
      if(_base STREQUAL "CC" AND NOT CMAKE_C_COMPILER)
        set(CMAKE_C_COMPILER "${_picked}")
      elseif(_base STREQUAL "CXX" AND NOT CMAKE_CXX_COMPILER)
        set(CMAKE_CXX_COMPILER "${_picked}")
      endif()
    endif()
  endforeach()
endif()

if(NOT _readcon_cross AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  execute_process(
    COMMAND g++ -print-file-name=libstdc++.so
    OUTPUT_VARIABLE _readcon_stdcxx
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE _readcon_stdcxx_rc
  )
  if(_readcon_stdcxx_rc EQUAL 0
     AND NOT _readcon_stdcxx STREQUAL ""
     AND NOT _readcon_stdcxx STREQUAL "libstdc++.so")
    get_filename_component(_readcon_stdcxx_dir "${_readcon_stdcxx}" DIRECTORY)
    if(IS_DIRECTORY "${_readcon_stdcxx_dir}")
      string(APPEND CMAKE_CXX_FLAGS_INIT " -L${_readcon_stdcxx_dir}")
      string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " -L${_readcon_stdcxx_dir}")
      string(APPEND CMAKE_SHARED_LINKER_FLAGS_INIT " -L${_readcon_stdcxx_dir}")
      string(APPEND CMAKE_MODULE_LINKER_FLAGS_INIT " -L${_readcon_stdcxx_dir}")
    endif()
  endif()
endif()
